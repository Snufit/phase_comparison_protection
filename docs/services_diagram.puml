@startuml Services Diagram

package "calculation.services" {

  package "Основные классы" {
    class FaultCalculationService {
      ~ FAULTS: dict = {"3psc": "К(3)", "2psc": "К(2)"}...
      ~ FAULT_CONFIG: dict = {"iopt_mde": "1", "iopt_cnf": "0"}...
      ~ LOG_FILE_PATH: str = "C:/Users/Gleb/OneDrive/Рабочий стол/М..."
      --
      + reset_log_file()
      + perform_branch_fault_calculation(app, protection_half_set: ProtectionHalfSet, submodes: typing.List[typing.Dict[str, typing.Union[typing.List[str], str]]], calculation_meta: CalculationMeta)
      + perform_fault_calculation(app, protection_half_set: ProtectionHalfSet, submodes: typing.List[typing.Dict[str, typing.Union[typing.List[str], str]]], calculation_meta: CalculationMeta)
    }

    class PowerFactoryManager {
      ~ POWERFACTORY_PATH: str = "C:/Program Files/DIgSILENT/PowerFacto..."
      ~ PROJECT_NAME: str = "ОДУ Сибири 1.0"
      --
      + __init__()
      + check_project_available(project_name)
      + get_application(project_name = None)
      + get_available_projects()
    }

    class ProjectSyncService {
      + __init__(project_name: str, default_device_model: str = "ШЭ 2607 081")
      + needs_sync()
      + sync_project(force_full: bool = False)
    }

    class SensitivityAnalysisService {
      + __init__(calculation_meta: CalculationMeta)
      + run()
    }

    class SensitivityFaultMap {
      ~ SENSITIVITY_FAULT_MAP: dict = {"IЛ ОТКЛ": "{'description': '...", "DI1 ОТКЛ": "{'description': '..."}...
      --
      + get_all_organs_requiring_faults()
      + get_all_required_fault_types()
      + get_fault_locations_for_organ(organ_name: str)
      + get_fault_map(organ_name: str)
      + get_fault_types_for_organ(organ_name: str)
      + get_powerfactory_fault_types(organ_name: str)
      + get_summary()
      + requires_branches(organ_name: str)
      + should_check_sensitivity(organ_name: str)
    }

    class SettingsCalculationService {
      + __init__(calculation_meta: CalculationMeta, calculation_factors: typing.Dict[str, float], enabled_organs: typing.Dict[str, bool] = None)
      + calculate_3i0_block()
      + calculate_3i0_break()
      + calculate_blocking_angle()
      + calculate_di1_block()
      + calculate_di1_break()
      + calculate_di2_block()
      + calculate_di2_break()
      + calculate_i2_block()
      + calculate_i2_break()
      + calculate_il_block()
      + calculate_il_break()
      + calculate_manipulation_factor()
      + calculate_r_break()
      + calculate_r_otv()
      + calculate_rnnp()
      + calculate_rtnp()
      + calculate_u2_block()
      + calculate_u2_break()
      + calculate_x_break()
      + calculate_x_otv()
      + get_calculation_function(component: Component)
      + run()
      + save_result_to_db(protection_half_set: ProtectionHalfSet, component: Component, calculation_factors: typing.Dict[str, float], result_value: float)
    }

    class TopologyAnalysisService {
      + __init__(protection_half_set: ProtectionHalfSet)
      + get_half_set_topology(app: typing.Union[typing.Any, NoneType] = None, force_refresh: bool = False)
    }

  }

  package "Вспомогательные модули" {
    object powerfactory_locator {
      PF_LINE_CLASS
      PF_SUBSTATION_CLASS
      --
      get_pf_line()
      get_pf_substation()
      get_powerfactory_object_by_full_name()
      get_lines_from_branch()
      get_line_type()
      _has_branches()
      _get_line_end_substations()
      _get_main_substations_with_voltage()
      _get_voltage_level()
      _has_parallel_counterparts()
      _log()
      _validate_branch_object()
      get_all_lines_with_indexes()
      get_pf_line_data()
      get_line_data_from_model()
    }

    object sensitivity_fault_map {
      POWERFACTORY_FAULT_TYPES
      FAULT_LOCATION_OPPOSITE_END
      FAULT_LOCATION_BRANCHES
    }

    object settings_calculation_map {
      SETTINGS_CALCULATION_MAP
    }

    object device_components_map {
      DEVICE_COMPONENTS_MAP
    }

    object submodes_generator {
      _calculate_params_hash()
      _save_submodes_to_db()
      generate_half_set_submodes()
      generate_submodes()
      get_elements_number_by_type()
      get_submode_name()
      transform_submodes()
      validate_submodes()
    }

    object powerfactory_manager {
      _log()
      handle_threading_error()
    }
  }
}

' ========== Связи между классами ==========

ProjectSyncService --> PowerFactoryManager : использует
ProjectSyncService --> TopologyAnalysisService : использует
ProjectSyncService --> FaultCalculationService : использует
TopologyAnalysisService ..> PowerFactoryManager : использует (внутри метода)
TopologyAnalysisService ..> FaultCalculationService : использует (для логирования)
SettingsCalculationService --> FaultCalculationService : использует
SensitivityAnalysisService --> FaultCalculationService : использует
SensitivityAnalysisService --> SensitivityFaultMap : использует
FaultCalculationService --> SensitivityFaultMap : использует

' ========== Связи классов с вспомогательными модулями ==========

FaultCalculationService ..> powerfactory_locator : использует\n(get_pf_line, get_pf_substation,\nget_powerfactory_object_by_full_name,\nget_lines_from_branch)
FaultCalculationService ..> sensitivity_fault_map : использует\n(SensitivityFaultMap,\nPOWERFACTORY_FAULT_TYPES,\nFAULT_LOCATION_OPPOSITE_END,\nFAULT_LOCATION_BRANCHES)
TopologyAnalysisService ..> powerfactory_locator : использует\n(get_pf_line, get_pf_substation)
ProjectSyncService ..> powerfactory_locator : использует\n(get_line_type, _has_branches,\n_get_line_end_substations,\n_get_main_substations_with_voltage,\nget_pf_line)
PowerFactoryManager ..> FaultCalculationService : использует\n(для логирования через _log)

' ========== Связи views с вспомогательными модулями ==========

note right of settings_calculation_map
  Используется в:
  - calculation.views
  (SETTINGS_CALCULATION_MAP)
end note

note right of submodes_generator
  Используется в:
  - calculation.views
  (generate_half_set_submodes)
end note

note right of powerfactory_locator
  Используется в:
  - calculation.views
  (get_pf_line_data, get_pf_line,
  get_line_data_from_model)
end note

note right of device_components_map
  Используется в:
  - calculation.views
  (опционально)
end note

@enduml
