{
    // Настройки для Django шаблонов
    "[django-html]": {
        "editor.formatOnSave": false,
        "editor.wordWrap": "on",
        "editor.rulers": [],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[html]": {
        "editor.formatOnSave": false,
        "editor.wordWrap": "on",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    // Отключаем автоформатирование для HTML файлов с Django шаблонами
    "files.associations": {
        "*.html": "django-html"
    },
    // Настройки для Python
    "[python]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [
            120
        ]
    },
    // Общие настройки
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    }
}